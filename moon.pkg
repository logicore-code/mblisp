// Package configuration for mblisp.
//
// The interpreter is intentionally self-contained: it depends only on
// the MoonBit standard library prelude. We pull in `ref` and
// `hashmap` from moonbitlang/core to back the global environment
// marker table; everything else is implemented from scratch.

import {
  "moonbitlang/core/ref",
  "moonbitlang/core/hashmap",
}
